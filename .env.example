# Safe local defaults
APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MEDIA_ORIGIN=
LOG_LEVEL=debug

# Add provider credentials for the intended environment only.
# Never commit real values or copy server-only values to NEXT_PUBLIC variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# PostgreSQL runtime: Supabase Transaction Pooler, port 6543
DATABASE_URL=

# Drizzle migrations: Direct or Session Pooler, port 5432
DATABASE_DIRECT_URL=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PRIVATE=
PRIVACY_HASH_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Transactional email
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Cloudflare Turnstile (required outside local development)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Distributed rate limits and QStash publisher/receiver credentials
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Error monitoring. The DSN is public; keep the build upload token server-only.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
